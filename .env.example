# Discord
DISCORD_TOKEN=dein_discord_bot_token
CHANNEL_ID=123456789012345678

# Tesla (Owner API via TeslaPy)
TESLA_EMAIL=deine@email.de
# Optional – bei mehreren Fahrzeugen:
# TESLA_VIN=5YJ3E1EA1KF123456
# Optional – Refresh-Token statt interaktivem Login (siehe README):
# TESLA_REFRESH_TOKEN=

# Timing
# Tesla-Abfrage (Fahrtenbuch + Status) – Standard: alle 90 Sekunden
TESLA_POLL_INTERVAL_SECONDS=90
# Discord erlaubt ~2 Channel-Renames / 10 Min.
CHANNEL_EDIT_COOLDOWN_MINUTES=6
# Akku-Cache max. Alter bei asleep/offline (Sekunden, Standard: 24h)
BATTERY_CACHE_MAX_AGE_SECONDS=86400
# Mindest-Fahrtstrecke für Fahrtenbuch-Eintrag (km)
TRIP_MIN_DISTANCE_KM=0.3

# Legacy (wird ignoriert wenn TESLA_POLL_INTERVAL_SECONDS gesetzt ist):
# UPDATE_INTERVAL_MINUTES=7

# Logging
LOG_LEVEL=INFO
# LOG_FILE=bot.log
