# Discord
DISCORD_TOKEN=dein_discord_bot_token
CHANNEL_ID=123456789012345678

# Tesla (Owner API via TeslaPy)
TESLA_EMAIL=deine@email.de
# Optional – bei mehreren Fahrzeugen:
# TESLA_VIN=5YJ3E1EA1KF123456
# Optional – Refresh-Token statt interaktivem Login (siehe README):
# TESLA_REFRESH_TOKEN=

# Timing (Discord erlaubt ~2 Channel-Renames / 10 Min.)
UPDATE_INTERVAL_MINUTES=7
CHANNEL_EDIT_COOLDOWN_MINUTES=6

# Logging
LOG_LEVEL=INFO
# LOG_FILE=bot.log
